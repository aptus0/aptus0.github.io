1:["$","main",null,{"children":[["$","header",null,{"className":"nav shell","children":[["$","a",null,{"className":"brand","href":"/","aria-label":"Ana sayfa","children":["$","img",null,{"src":"/logo.svg","alt":"Samet ER — Salesforce Developer"}]}],["$","nav",null,{"aria-label":"Ana menü","children":[["$","a",null,{"href":"/en/projects","children":"Projects"}],["$","a",null,{"href":"/en/services","children":"Services"}],["$","a",null,{"href":"/en/about","children":"About"}],["$","a",null,{"href":"/en/blog","children":"Blog"}]]}],["$","a",null,{"className":"language-switch","href":"/","lang":"tr","children":"TR"}],["$","a",null,{"className":"nav-cta","href":"https://www.linkedin.com/in/samet-er-75915a3a3/","target":"_blank","rel":"noreferrer","children":["Let's work together"," ",["$","span",null,{"children":"↗"}]]}]]}],["$","article",null,{"className":"shell blog-article","children":[["$","a",null,{"className":"blog-back","href":"/en/blog","children":"← All articles"}],["$","div",null,{"className":"blog-article-heading","children":[["$","span",null,{"className":"section-number","children":"Technical note"}],["$","h1",null,{"children":"Why should ERP, CRM and e-commerce share the same data?"}],["$","p",null,{"children":"How disconnected systems increase operational cost—and what a sound integration architecture changes."}],["$","time",null,{"dateTime":"2026-07-31","children":"2026-07-31"}]]}],["$","div",null,{"className":"blog-body","children":[["$","p","When a web store, mobile application, ERP and CRM identify the same customer differently, the problem is not merely technical. Stock errors, delayed orders and incomplete customer visibility directly affect operational quality.",{"children":"When a web store, mobile application, ERP and CRM identify the same customer differently, the problem is not merely technical. Stock errors, delayed orders and incomplete customer visibility directly affect operational quality."}],["$","p","In a healthy architecture, ERP is the source of inventory and finance data, CRM is the customer engagement workspace, and e-commerce is the ordering experience. Their responsibilities differ, but product, customer and order identities must follow a shared data contract.",{"children":"In a healthy architecture, ERP is the source of inventory and finance data, CRM is the customer engagement workspace, and e-commerce is the ordering experience. Their responsibilities differ, but product, customer and order identities must follow a shared data contract."}],["$","p","I treat integration as a foundational product decision rather than an add-on. This allows web, mobile, store and sales teams to work from the same operational truth.",{"children":"I treat integration as a foundational product decision rather than an add-on. This allows web, mobile, store and sales teams to work from the same operational truth."}]]}]]}],["$","section",null,{"className":"contact page-contact","children":["$","footer",null,{"className":"shell","children":[["$","a",null,{"className":"brand","href":"/","aria-label":"Ana sayfaya dön","children":["$","img",null,{"src":"/logo.svg","alt":"Samet ER — Salesforce Developer"}]}],["$","p",null,{"children":["© 2026 Samet ER. Bursa, ","Türkiye","."]}],["$","div",null,{"children":[["$","a",null,{"href":"https://www.linkedin.com/in/samet-er-75915a3a3/","target":"_blank","rel":"noreferrer","children":"LinkedIn"}],["$","a",null,{"href":"https://github.com/aptus0","target":"_blank","rel":"noreferrer","children":"GitHub"}]]}]]}]}]]}]
